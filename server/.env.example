# ScrapSetu Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Connection (Default SQLite for standalone evaluation; swap to postgresql:// for PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=scrapsetu_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Optional External AI API Key (Gemini)
# Leave blank to automatically use ScrapSetu's built-in intelligent heuristic vision & pricing fallback service
GEMINI_API_KEY=

# Upload Storage Directory
UPLOAD_DIR=./uploads

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# ScrapSetu Environment Configuration Template
PORT=5000
NODE_ENV=development

# ==============================================================================
# Database Connection Strings (Choose one):
# ==============================================================================
# OPTION 1: 100% Free Supabase PostgreSQL (Recommended - 500 MB Free Tier)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# OPTION 2: 100% Free Neon Serverless PostgreSQL (0.5 GiB Free Tier)
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-2.aws.neon.tech/neondb?sslmode=require"

# OPTION 3: 100% Free MongoDB Atlas M0 Sandbox (512 MB Free Tier)
# MONGODB_URI="mongodb+srv://[USER]:[PASSWORD]@cluster0.abcde.mongodb.net/scrapsetu?retryWrites=true&w=majority"

# OPTION 4: Local Zero-Config SQLite (Default for offline demo/testing)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=scrapsetu_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Optional External AI API Key (Gemini)
# Leave blank to automatically use ScrapSetu's built-in intelligent heuristic vision & pricing fallback service
GEMINI_API_KEY=

# Upload Storage Directory
UPLOAD_DIR=./uploads

# Client URL for CORS
CLIENT_URL=http://localhost:5173

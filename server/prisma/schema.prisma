generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String
  phone           String
  role            String         // HOUSEHOLD, BUSINESS, COLLECTOR, RECYCLER, ADMIN
  languagePref    String         @default("en") // en, hi
  isVerified      Boolean        @default(false)
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile         UserProfile?
  addresses       Address[]
  verifications   VerificationDocument[]
  requests        PickupRequest[]        @relation("RequesterPickups")
  assignedPickups CollectorAssignment[]
  transactionsAsCollector Transaction[]   @relation("CollectorTransactions")
  transactionsAsRequester Transaction[]   @relation("RequesterTransactions")
  recyclerOffers  RecyclerOffer[]
  recyclerIntakes RecyclerIntake[]
  ratingsGiven    RatingFeedback[]       @relation("RatingsGiven")
  ratingsReceived RatingFeedback[]       @relation("RatingsReceived")
  notifications   Notification[]
  complaintsFiled ComplaintDispute[]     @relation("Complainant")
  auditLogs       AuditLog[]
  collectorLots   ScrapLot[]             @relation("CollectorLots")
  buyerLots       ScrapLot[]             @relation("BuyerLots")
  createdPools    ScrapPool[]            @relation("CreatedPools")
  buyerPools      ScrapPool[]            @relation("BuyerPools")
  collectorPledges PoolPledge[]          @relation("CollectorPledges")
  voiceLogs       VoiceCommandLog[]

  @@index([role])
  @@index([email])
}

model UserProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String?
  businessType        String?  // RESTAURANT, OFFICE, RETAIL, APARTMENT_COMPLEX, MANUFACTURING
  gstNumber           String?
  idDocumentNumber    String?  // Masked or hashed
  vehicleType         String?  // THREE_WHEELER, CYCLE_RICKSHAW, MINI_TRUCK, HAND_CART
  vehicleNumber       String?
  serviceAreaRadiusKm Float    @default(5.0)
  dailyCapacityKg     Float    @default(100.0)
  acceptedCategories  String?  // JSON string array of category slugs
  operatingHours      String?
  bankUpiId           String?
  isAvailable         Boolean  @default(true)
  totalPickupsCompleted Int    @default(0)
  reliabilityRating   Float    @default(5.0)
}

model Address {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String          @default("Home") // Home, Warehouse, Factory, Shop
  streetAddress String
  area          String?
  city          String          @default("Jaipur")
  state         String          @default("Rajasthan")
  pincode       String
  lat           Float           @default(26.9124)
  lng           Float           @default(75.7873)
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())

  pickupRequests PickupRequest[]

  @@index([userId])
}

model VerificationDocument {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String   // AADHAAR, PAN, GST_CERT, RECYCLER_LICENSE, CPCB_REGISTRATION
  documentNumber  String?
  documentUrl     String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerNotes   String?
  reviewerId      String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?

  @@index([userId])
  @@index([status])
}

model MaterialCategory {
  id                String          @id @default(uuid())
  name              String          @unique
  hindiName         String
  slug              String          @unique
  description       String
  hindiDescription  String
  icon              String          @default("Recycle")
  defaultUnit       String          @default("kg") // kg, piece
  carbonFactorKg    Float           @default(1.2) // CO2e kg saved per kg recycled
  treeFactorKg      Float           @default(0.0) // trees saved per kg paper
  waterFactorL      Float           @default(15.0) // litres of water saved per kg
  energyFactorKwh   Float           @default(3.5) // kWh saved per kg
  createdAt         DateTime        @default(now())

  prices            MaterialPrice[]
  pickupItems       PickupItem[]
  recyclerOffers    RecyclerOffer[]
  actualCollected   ActualCollectedItem[]
  scrapLots         ScrapLot[]
  scrapPools        ScrapPool[]
}

model MaterialPrice {
  id                String           @id @default(uuid())
  categoryId        String
  category          MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  grade             String           @default("Standard") // Standard, High-grade, Clean, Mixed
  unit              String           @default("kg")
  indicativePrice   Float            // Indicative baseline price per unit (INR)
  minPrice          Float
  maxPrice          Float
  region            String           @default("North India (Jaipur/Delhi-NCR)")
  source            String           @default("Demonstration Benchmark (MRAI & Local Mandi Index)")
  isDemo            Boolean          @default(true)
  effectiveDate     DateTime         @default(now())
  lastUpdated       DateTime         @updatedAt

  @@index([categoryId])
  @@index([region])
}

model RecyclerOffer {
  id                String           @id @default(uuid())
  recyclerId        String
  recycler          User             @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  categoryId        String
  category          MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  facilityName      String
  facilityAddress   String
  lat               Float            @default(26.9124)
  lng               Float            @default(75.7873)
  buyingPricePerKg  Float
  minQuantityKg     Float            @default(25.0)
  maxCapacityKg     Float            @default(5000.0)
  currentIntakeKg   Float            @default(0.0)
  handlingFeePerKg  Float            @default(0.0)
  paymentTerms      String           @default("INSTANT_BANK_TRANSFER")
  gradeAccepted     String           @default("Any clean grade")
  notes             String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  recyclerIntakes   RecyclerIntake[]
  scrapLots         ScrapLot[]
  scrapPools        ScrapPool[]

  @@index([recyclerId])
  @@index([categoryId])
}

model PickupRequest {
  id                     String                 @id @default(uuid())
  requesterId            String
  requester              User                   @relation("RequesterPickups", fields: [requesterId], references: [id], onDelete: Cascade)
  addressId              String
  address                Address                @relation(fields: [addressId], references: [id])
  preferredDate          String
  preferredTimeSlot      String                 // Morning (9 AM - 12 PM), Afternoon (12 PM - 3 PM), Evening (3 PM - 6 PM)
  notes                  String?
  status                 String                 @default("OPEN") // OPEN, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED, DISPUTED
  estimatedTotalWeightKg Float                  @default(0)
  estimatedTotalValue    Float                  @default(0)
  isRecurring            Boolean                @default(false)
  recurringFrequency     String?                // WEEKLY, BIWEEKLY, MONTHLY
  assignedCollectorId    String?
  cancelledReason        String?
  disputeReason          String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  items                  PickupItem[]
  assignments            CollectorAssignment[]
  statusHistory          PickupStatusHistory[]
  actualCollected        ActualCollectedItem[]
  transaction            Transaction?
  ratings                RatingFeedback[]
  complaints             ComplaintDispute[]
  scrapLots              ScrapLot[]

  @@index([requesterId])
  @@index([status])
  @@index([assignedCollectorId])
}

model PickupItem {
  id                    String           @id @default(uuid())
  pickupRequestId       String
  pickupRequest         PickupRequest    @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  categoryId            String
  category              MaterialCategory @relation(fields: [categoryId], references: [id])
  estimatedQty          Float
  unit                  String           @default("kg")
  photoUrl              String?
  aiPredictedCategory   String?
  aiConfidence          Float?
  userConfirmedCategory Boolean          @default(true)
  gradeNotes            String?

  @@index([pickupRequestId])
  @@index([categoryId])
}

model CollectorAssignment {
  id               String        @id @default(uuid())
  pickupRequestId  String
  pickupRequest    PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  collectorId      String
  collector        User          @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  status           String        @default("ACCEPTED") // OFFERED, ACCEPTED, REJECTED, EN_ROUTE, ARRIVED, COMPLETED, CANCELLED
  distanceKm       Float         @default(1.5)
  matchScore       Float         @default(90.0)
  matchExplanation String?       // Distance: 1.2km | Material match: Paper, Iron | Rating: 4.9★
  assignedAt       DateTime      @default(now())
  acceptedAt       DateTime?
  arrivedAt        DateTime?
  completedAt      DateTime?

  @@index([pickupRequestId])
  @@index([collectorId])
}

model PickupStatusHistory {
  id              String        @id @default(uuid())
  pickupRequestId String
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedById     String
  changeReason    String?
  timestamp       DateTime      @default(now())

  @@index([pickupRequestId])
}

model ActualCollectedItem {
  id                 String           @id @default(uuid())
  pickupRequestId    String
  pickupRequest      PickupRequest    @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  categoryId         String
  category           MaterialCategory @relation(fields: [categoryId], references: [id])
  actualQty          Float
  agreedPricePerUnit Float
  itemTotal          Float
  weighingProofUrl   String?
  gradeRecorded      String?

  @@index([pickupRequestId])
  @@index([categoryId])
}

model Transaction {
  id               String               @id @default(uuid())
  pickupRequestId  String               @unique
  pickupRequest    PickupRequest        @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  collectorId      String
  collector        User                 @relation("CollectorTransactions", fields: [collectorId], references: [id])
  requesterId      String
  requester        User                 @relation("RequesterTransactions", fields: [requesterId], references: [id])
  recyclerId       String?
  totalWeightKg    Float                @default(0)
  totalAmount      Float
  paymentMode      String               @default("CASH") // CASH, UPI, BANK_TRANSFER
  paymentStatus    String               @default("PAID") // PENDING, PAID, DISPUTED
  receiptNumber    String               @unique
  receiptHash      String               // SHA256 checksum for tamper-evident digital receipt
  notes            String?
  transactionDate  DateTime             @default(now())
  recyclerIntake   RecyclerIntake?

  @@index([collectorId])
  @@index([requesterId])
  @@index([receiptNumber])
}

model RecyclerIntake {
  id                 String         @id @default(uuid())
  transactionId      String?        @unique
  transaction        Transaction?   @relation(fields: [transactionId], references: [id])
  recyclerId         String
  recycler           User           @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  offerId            String?
  offer              RecyclerOffer? @relation(fields: [offerId], references: [id])
  supplierName       String         // Collector or bulk seller name
  materialGrade      String
  netWeightKg        Float
  purchaseRatePerKg  Float
  totalPurchaseAmount Float
  intakeSlipNumber   String         @unique
  receiptHash        String
  createdAt          DateTime       @default(now())

  @@index([recyclerId])
}

model RatingFeedback {
  id                     String        @id @default(uuid())
  pickupRequestId        String
  pickupRequest          PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  fromUserId             String
  fromUser               User          @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId               String
  toUser                 User          @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  rating                 Int           // 1 to 5
  reviewText             String?
  categoryAccuracyRating Int?          // 1 to 5
  punctualityRating      Int?          // 1 to 5
  createdAt              DateTime      @default(now())

  @@index([pickupRequestId])
  @@index([toUserId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, PICKUP_UPDATE, PAYMENT, VERIFICATION, ALERT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ComplaintDispute {
  id              String        @id @default(uuid())
  pickupRequestId String?
  pickupRequest   PickupRequest? @relation(fields: [pickupRequestId], references: [id], onDelete: SetNull)
  complainantId   String
  complainant     User          @relation("Complainant", fields: [complainantId], references: [id], onDelete: Cascade)
  respondentId    String?
  subject         String
  description     String
  status          String        @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  resolution      String?
  resolvedById    String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  @@index([complainantId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // CREATE_PICKUP, ACCEPT_PICKUP, COMPLETE_TRANSACTION, VERIFY_USER, UPDATE_PRICE, RESOLVE_DISPUTE
  resource   String
  resourceId String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ScrapLot {
  id                     String           @id @default(uuid())
  lotNumber              String           @unique // e.g. LOT-2026-X8K9M2
  qrCodeData             String           // Traceability URL / identifier
  pickupRequestId        String?
  pickupRequest          PickupRequest?   @relation(fields: [pickupRequestId], references: [id], onDelete: SetNull)
  collectorId            String
  collector              User             @relation("CollectorLots", fields: [collectorId], references: [id], onDelete: Cascade)
  buyerId                String?
  buyer                  User?            @relation("BuyerLots", fields: [buyerId], references: [id], onDelete: SetNull)
  selectedOfferId        String?
  selectedOffer          RecyclerOffer?   @relation(fields: [selectedOfferId], references: [id], onDelete: SetNull)
  categoryId             String
  category               MaterialCategory @relation(fields: [categoryId], references: [id])
  grade                  String           @default("Standard")
  declaredWeightKg       Float
  collectedWeightKg      Float?
  receivedWeightKg       Float?
  weightDiscrepancyKg    Float?           // receivedWeightKg - collectedWeightKg
  discrepancyPercentage  Float?
  hasDiscrepancy         Boolean          @default(false)
  isDisputed             Boolean          @default(false)
  disputeReason          String?
  status                 String           @default("GENERATED")
  // Stages: GENERATED, BOOKED, COLLECTED, WEIGHED, BUYER_SELECTED, HANDED_OVER, RECEIVED, PROCESSING_CONFIRMED
  agreedRatePerKg        Float?
  estimatedGrossValue    Float?
  estimatedTransportCost Float?
  estimatedNetProceeds   Float?
  processingMethod       String?          // SHREDDED_WASHED, INDUCTION_MELTED, RPET_PELLETIZED, PULPED
  processingBatchNumber  String?
  processingEvidenceUrl  String?
  processingNotes        String?
  processingConfirmedAt  DateTime?
  cpcbComplianceRef      String?
  originCity             String           @default("Jaipur")
  originState            String           @default("Rajasthan")
  originPincode          String?
  currentHashSha256      String           // Cryptographic seal
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  events                 ScrapLotEvent[]
  poolPledges            PoolPledge[]

  @@index([lotNumber])
  @@index([collectorId])
  @@index([buyerId])
  @@index([status])
}

model ScrapLotEvent {
  id           String   @id @default(uuid())
  scrapLotId   String
  scrapLot     ScrapLot @relation(fields: [scrapLotId], references: [id], onDelete: Cascade)
  stage        String   // GENERATED, BOOKED, COLLECTED, WEIGHED, BUYER_SELECTED, HANDED_OVER, RECEIVED, PROCESSING_CONFIRMED
  actorRole    String   // CITIZEN, COLLECTOR, RECYCLER, SYSTEM, ADMIN
  actorName    String
  actorId      String?
  location     String?
  evidenceType String   @default("SYSTEM_RECORDED") // SELF_REPORTED, SYSTEM_RECORDED, INDEPENDENTLY_VERIFIED
  details      String?  // JSON description or summary
  eventHash    String   // SHA-256 seal
  timestamp    DateTime @default(now())

  @@index([scrapLotId])
  @@index([stage])
}

model ScrapPool {
  id                 String           @id @default(uuid())
  poolCode           String           @unique // e.g. POOL-2026-PLAS-001
  title              String
  description        String?
  creatorId          String
  creator            User             @relation("CreatedPools", fields: [creatorId], references: [id], onDelete: Cascade)
  categoryId         String
  category           MaterialCategory @relation(fields: [categoryId], references: [id])
  targetWeightKg     Float
  currentPledgedKg   Float            @default(0.0)
  targetPricePerKg   Float            // Bulk negotiated price
  baselinePricePerKg Float            // Single-lot baseline price
  collectionDeadline DateTime
  status             String           @default("OPEN") // OPEN, TARGET_REACHED, MATCHED, DISPATCHED, SETTLED, CANCELLED
  hubLocationName    String           @default("Mansarovar Circular Recovery Hub")
  hubAddress         String           @default("Sector 4, RIICO Industrial Area, Mansarovar, Jaipur")
  hubLat             Float            @default(26.8450)
  hubLng             Float            @default(75.7600)
  matchedBuyerId     String?
  matchedBuyer       User?            @relation("BuyerPools", fields: [matchedBuyerId], references: [id], onDelete: SetNull)
  matchedOfferId     String?
  matchedOffer       RecyclerOffer?   @relation(fields: [matchedOfferId], references: [id], onDelete: SetNull)
  bulkNegotiatedRate Float?
  totalPoolValue     Float?
  disbursementStatus String           @default("PENDING_SALE") // PENDING_SALE, BUYER_CONFIRMED, AWAITING_PAYMENT_PROOF, SETTLED, DISPUTED
  paymentReference   String?
  settlementNotes    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  pledges            PoolPledge[]
  activities         PoolActivityLog[]

  @@index([poolCode])
  @@index([creatorId])
  @@index([categoryId])
  @@index([status])
}

model PoolPledge {
  id               String    @id @default(uuid())
  poolId           String
  pool             ScrapPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  collectorId      String
  collector        User      @relation("CollectorPledges", fields: [collectorId], references: [id], onDelete: Cascade)
  scrapLotId       String?
  scrapLot         ScrapLot? @relation(fields: [scrapLotId], references: [id], onDelete: SetNull)
  pledgedWeightKg  Float
  verifiedWeightKg Float?
  allocatedPayout  Float?
  status           String    @default("PLEDGED") // PLEDGED, VERIFIED, WITHDRAWN, SETTLED, REJECTED
  disputeNotes     String?
  pledgedAt        DateTime  @default(now())
  verifiedAt       DateTime?
  settledAt        DateTime?

  @@index([poolId])
  @@index([collectorId])
  @@index([scrapLotId])
  @@index([status])
}

model PoolActivityLog {
  id        String    @id @default(uuid())
  poolId    String
  pool      ScrapPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String
  action    String    // CREATED, PLEDGED, WITHDRAWN, TARGET_MET, BUYER_MATCHED, VERIFIED, DISPATCHED, SETTLED, DISPUTED
  details   String?
  timestamp DateTime  @default(now())

  @@index([poolId])
}

model VoiceCommandLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript       String
  language         String   @default("hi") // hi, en
  recognizedAction String   // NAVIGATE_JOBS, NAVIGATE_EARNINGS, NAVIGATE_BUYERS, COMPLETE_PICKUP, NAVIGATE_POOLING, SHOW_RATES, UNKNOWN
  actionPayload    String?
  status           String   @default("RECOGNIZED") // RECOGNIZED, CONFIRMED, EXECUTED, CANCELLED, FAILED
  networkOnline    Boolean  @default(true)
  timestamp        DateTime @default(now())

  @@index([userId])
  @@index([recognizedAction])
  @@index([timestamp])
}

